<UserControl x:Class="AdamsToolkit.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- tira de métrica -->
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrMuted}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
        </Style>
        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource BrMuted}"/>
        </Style>
        <Style x:Key="SpecKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrMuted}"/>
        </Style>
        <Style x:Key="SpecVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
        </Style>
        <Style x:Key="ChartBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Height" Value="118"/>
        </Style>
        <LinearGradientBrush x:Key="ChartFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66A66BFF" Offset="0"/>
            <GradientStop Color="#00A66BFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource BrSurface}" BorderBrush="{DynamicResource BrBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="10,14" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrActive}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrActiveBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <!-- cabeçalho -->
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Início" Style="{StaticResource H1}"/>
                    <TextBlock Text="Visão geral do teu PC" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrSurface}" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock x:Name="ActivePill" FontSize="11" Foreground="{DynamicResource BrMuted}"/>
                    </Border>
                    <Border Background="{DynamicResource BrSurface}" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock x:Name="PendingPill" FontSize="11" Foreground="{DynamicResource BrMuted}"/>
                    </Border>
                    <Border x:Name="AdminPillBox" CornerRadius="8" Padding="10,5" Cursor="Hand" MouseLeftButtonUp="AdminPill_Click">
                        <TextBlock x:Name="AdminPill" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 6 tiras -->
            <Grid Margin="0,0,-10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="CpuSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="RamText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="RamSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="GpuText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="GpuSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="DISCO" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="DiskText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="DiskSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="REDE" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="NetText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="NetSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="PING ATL PVP" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="PingText" Text="—" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="PingSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- especificações -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Especificações" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="SISTEMA" Style="{StaticResource SpecKey}"/>
                        <TextBlock Text="PROCESSADOR" Style="{StaticResource SpecKey}"/>
                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource SpecKey}"/>
                        <TextBlock Text="PLACA GRÁFICA" Style="{StaticResource SpecKey}"/>
                        <TextBlock Text="DISCO" Style="{StaticResource SpecKey}"/>
                        <TextBlock Text="LIGADO HÁ" Style="{StaticResource SpecKey}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock Text=" " Style="{StaticResource Body}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SpecOs" Style="{StaticResource SpecVal}"/>
                        <TextBlock x:Name="SpecCpu" Style="{StaticResource SpecVal}"/>
                        <TextBlock x:Name="SpecRam" Style="{StaticResource SpecVal}"/>
                        <TextBlock x:Name="SpecGpu" Style="{StaticResource SpecVal}"/>
                        <TextBlock x:Name="SpecDisk" Style="{StaticResource SpecVal}"/>
                        <TextBlock x:Name="SpecUptime" Style="{StaticResource SpecVal}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- desempenho ao vivo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Desempenho ao vivo" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition Height="10"/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource ChartBox}">
                            <Grid>
                                <TextBlock Text="CPU %" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="CpuChartVal" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource BrAccent}"/>
                                <Grid x:Name="CpuHost" Margin="0,20,0,0">
                                    <Path x:Name="CpuFill" Fill="{StaticResource ChartFillBrush}"/>
                                    <Path x:Name="CpuLine" Stroke="{DynamicResource BrAccent}" StrokeThickness="2"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ChartBox}">
                            <Grid>
                                <TextBlock Text="RAM %" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="RamChartVal" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource BrAccent}"/>
                                <Grid x:Name="RamHost" Margin="0,20,0,0">
                                    <Path x:Name="RamFill" Fill="{StaticResource ChartFillBrush}"/>
                                    <Path x:Name="RamLine" Stroke="{DynamicResource BrAccent}" StrokeThickness="2"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource ChartBox}">
                            <Grid>
                                <TextBlock Text="REDE ↓" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="NetChartVal" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource BrAccent}"/>
                                <Grid x:Name="NetHost" Margin="0,20,0,0">
                                    <Path x:Name="NetFill" Fill="{StaticResource ChartFillBrush}"/>
                                    <Path x:Name="NetLine" Stroke="{DynamicResource BrAccent}" StrokeThickness="2"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartBox}">
                            <Grid>
                                <TextBlock Text="PING (ms)" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="PingChartVal" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource BrAccent}"/>
                                <Grid x:Name="PingHost" Margin="0,20,0,0">
                                    <Path x:Name="PingFill" Fill="{StaticResource ChartFillBrush}"/>
                                    <Path x:Name="PingLine" Stroke="{DynamicResource BrAccent}" StrokeThickness="2"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- saúde + ações rápidas -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Saúde do PC" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       ToolTip="Média de: memória livre, espaço no disco, ajustes recomendados ativos e temperatura da GPU."/>
                            <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="Diagnóstico →" Click="Diag_Click" Margin="0,-6"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="86" Height="86">
                                <Ellipse Stroke="{DynamicResource BrBorder}" StrokeThickness="7"/>
                                <Path x:Name="HealthArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource BrAccent}"/>
                                <TextBlock x:Name="HealthText" Text="—" FontFamily="{StaticResource FontDisplay}" FontSize="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrText}"/>
                            </Grid>
                            <ItemsControl Grid.Column="1" x:Name="HealthBars" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource BrMuted}"/>
                                            <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrBorder}" CornerRadius="3"/>
                                                <Border Background="{DynamicResource BrAccentGradient}" CornerRadius="3" HorizontalAlignment="Left"
                                                        Width="{Binding Width}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="10.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource BrText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ações rápidas" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4" Margin="0,0,-8,0">
                            <Button x:Name="RestoreBtn" Style="{StaticResource ActionTile}" Click="Restore_Click">
                                <StackPanel>
                                    <TextBlock Text="⛑" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ponto de restauro" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="Optimize_Click">
                                <StackPanel>
                                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Otimizar" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="GameMode_Click">
                                <StackPanel>
                                    <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Modo Jogo" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="PcCheck_Click">
                                <StackPanel>
                                    <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pronto p/ PC check?" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock x:Name="ActionStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- novidades da comunidade (config remota; some se não houver) -->
            <Border x:Name="NewsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CommunityText" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="NewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,90,0"/>
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
