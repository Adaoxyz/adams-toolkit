<Window x:Class="AdamsToolkit.UpdateSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adams Toolkit" Width="380" Height="120" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico" Topmost="True"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="14" Background="{DynamicResource BrBg}" BorderBrush="{DynamicResource BrAccentGradient}" BorderThickness="1" Padding="22,18">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="Msg" Text="A verificar atualizações…" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ProgressBar Style="{StaticResource DlProgress}" IsIndeterminate="True" Height="5" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
