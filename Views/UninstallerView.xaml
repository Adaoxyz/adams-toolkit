<UserControl x:Class="AdamsToolkit.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- pesquisa com placeholder -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="34,8,12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{DynamicResource BrSurface}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <TextBlock Text="🔍" FontSize="12" Opacity="0.6" Margin="12,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Style="{StaticResource Muted}"
                                           FontSize="12.5" Margin="34,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- separador segmentado -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BrMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="16,8" Margin="3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrAccentGradient}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- etiqueta pequena (versão / tipo) -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrSurface}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- ícone tile -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource BrSurface}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- botão perigoso (vermelho) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource BrDanger}"/>
        </Style>

        <!-- linha da lista: card com hover + seleção em acento -->
        <Style x:Key="ProgramRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource BrCard}" CornerRadius="12"
                                BorderThickness="1" BorderBrush="Transparent"
                                Padding="14,10" Margin="0,0,0,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrCardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== cabeçalho ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Desinstalador" Style="{StaticResource H1}"/>
            <TextBlock x:Name="SubtitleText" Text="A carregar programas…"
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ===== barra: separadores · pesquisa · atualizar ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BrSurface}" CornerRadius="11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabPrograms" Style="{StaticResource SegBtn}" Content="📦  Programas" IsChecked="True" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabAppx" Style="{StaticResource SegBtn}" Content="⊞  Apps do Windows" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabStorage" Style="{StaticResource SegBtn}" Content="💾  Armazenamento" Checked="Tab_Changed"/>
                    </StackPanel>
                </Border>
                <TextBox Grid.Column="1" x:Name="SearchInput" Style="{StaticResource SearchBox}"
                         Tag="Pesquisar por nome ou fabricante…" Margin="12,0" VerticalAlignment="Center"
                         TextChanged="Search_Changed"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="🔄  Atualizar"
                        VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <!-- ===== aviso admin ===== -->
        <Border Grid.Row="2" x:Name="AdminBanner" Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Body}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="⚠️  Sem administrador, restos em Program Files / registry do sistema podem falhar ao apagar."/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="🛡  Reiniciar como admin"
                        Margin="12,0,0,0" Click="RestartAdmin_Click"/>
            </Grid>
        </Border>

        <!-- ===== listas ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- cabeçalho de colunas -->
            <Grid Grid.Row="0" x:Name="ColHeader" Margin="15,0,15,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="NOME" Style="{StaticResource ColHead}"/>
                <TextBlock Grid.Column="2" Text="VERSÃO" Style="{StaticResource ColHead}"/>
                <TextBlock Grid.Column="3" Text="TAMANHO" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" x:Name="ColLast" Text="INSTALADO" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="1">
                <!-- programas (registry) -->
                <ListBox x:Name="ProgramsList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource ProgramRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="Program_Selected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <Grid>
                                        <TextBlock Text="📦" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="26" Height="26"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}"
                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" HorizontalAlignment="Left" MaxWidth="120">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource PillText}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource Body}" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding DateLabel}" Style="{StaticResource Muted}" FontSize="11.5"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- apps do Windows (Store / Appx) -->
                <ListBox x:Name="AppxList" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed"
                         ItemContainerStyle="{StaticResource ProgramRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="Appx_Selected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Background="#1AA855F7">
                                    <Grid>
                                        <TextBlock Text="⊞" FontSize="16" Foreground="{DynamicResource BrAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="28" Height="28"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}"
                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" HorizontalAlignment="Left" MaxWidth="120">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource PillText}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource Body}" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Border Grid.Column="4" Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="#1AA855F7">
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource PillText}" Foreground="{DynamicResource BrAccent}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- armazenamento: pastas por tamanho -->
                <Grid x:Name="StoragePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <!-- discos + breadcrumb -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="DriveList" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="12,7"
                                                Tag="{Binding Root}" Click="Drive_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                                <ProgressBar Value="{Binding UsedPct, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,2"
                                                             Background="{DynamicResource BrSurface}" Foreground="{DynamicResource BrAccent}" BorderThickness="0"/>
                                                <TextBlock Text="{Binding FreeLabel}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock x:Name="StoragePathText" Style="{StaticResource Body}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Text="Escolhe um disco para ver o que ocupa mais espaço."/>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="Breadcrumb">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding Name}" Tag="{Binding Path}" Click="Crumb_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0" Padding="2,1"
                                                            Foreground="{DynamicResource BrAccent}" FontSize="12.5" FontWeight="SemiBold">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Text="›" Style="{StaticResource Muted}" Margin="4,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="StorageStateText" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StorageBackBtn" Style="{StaticResource GhostButton}" Content="←  Anterior" Padding="12,8"
                                        Margin="0,0,8,0" IsEnabled="False" ToolTip="Volta à pasta onde estavas" Click="StorageBack_Click"/>
                                <Button x:Name="StorageUpBtn" Style="{StaticResource GhostButton}" Content="⬆  Subir" Padding="12,8"
                                        Margin="0,0,8,0" IsEnabled="False" ToolTip="Pasta acima" Click="StorageUp_Click"/>
                                <Button x:Name="StorageOpenBtn" Style="{StaticResource GhostButton}" Content="📁  Abrir no Explorador" Padding="12,8"
                                        IsEnabled="False" Click="StorageOpen_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="StorageList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource ProgramRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="Storage_Selected" MouseDoubleClick="Storage_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="5" Text="{Binding Chevron}" Style="{StaticResource Muted}" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <Border Background="{DynamicResource BrSurface}" CornerRadius="4" Height="8"/>
                                        <Border Background="{DynamicResource BrAccentGradient}" CornerRadius="4" Height="8"
                                                HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource Body}" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PctLabel}" Style="{StaticResource Muted}" FontSize="11.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Visibility, ElementName=EmptyText}">
                    <TextBlock Text="🗂" FontSize="34" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Text="Nenhum programa encontrado."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ===== painel de restos (overlay) ===== -->
                <Border x:Name="LeftoversPanel" Background="{DynamicResource BrCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="14" Visibility="Collapsed">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="#1AEF4444">
                                <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LeftoversTitle" Style="{StaticResource H2}" Text="Restos encontrados"/>
                                <TextBlock x:Name="LeftoversSubtitle" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Confirma cada item antes de apagar — isto remove ficheiros e chaves de registry."/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LeftoversList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrSurface}" CornerRadius="9"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding KindIcon}" FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" Style="{StaticResource Body}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Display}"/>
                                                    <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}"
                                                               FontSize="11" Foreground="{DynamicResource BrDanger}"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}"
                                                           Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Marcar tudo"
                                        Click="LeftoversSelectAll_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="Desmarcar tudo"
                                        Click="LeftoversSelectNone_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Fechar"
                                        Click="LeftoversClose_Click" Margin="0,0,8,0"/>
                                <Button x:Name="DeleteLeftoversBtn" Style="{StaticResource DangerButton}"
                                        Content="🗑  Remover tudo do PC" Click="LeftoversDelete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== barra de ação do item selecionado ===== -->
        <Border Grid.Row="4" x:Name="ActionBar" Background="{DynamicResource BrCard}"
                BorderBrush="{DynamicResource BrAccent}" BorderThickness="1" CornerRadius="14"
                Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Background="#1AA855F7">
                    <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedName" Style="{StaticResource Body}" FontWeight="SemiBold"
                               FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="UninstallBtn" Style="{StaticResource PrimaryButton}" Content="🧹  Desinstalar"
                        Padding="22,11" VerticalAlignment="Center" Margin="16,0,0,0"
                        ToolTip="Corre o desinstalador oficial, procura tudo o que ficou no PC e pede confirmação antes de remover"
                        Click="Uninstall_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
