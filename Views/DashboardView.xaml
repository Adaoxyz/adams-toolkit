<UserControl x:Class="AdamsToolkit.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- anel de progresso: pista + arco (o arco é desenhado no code-behind) -->
        <Style x:Key="GaugeTrack" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource BrBorder}"/>
            <Setter Property="StrokeThickness" Value="3.4"/>
        </Style>
        <Style x:Key="GaugeArc" TargetType="Path">
            <Setter Property="StrokeThickness" Value="3.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <!-- sparkline no fundo do tile -->
        <Style x:Key="Spark" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>

            <!-- ===== Banner ===== -->
            <Grid Height="200" Margin="0,0,0,16">
                <Border CornerRadius="16" Background="{DynamicResource BrHero}" ClipToBounds="True">
                    <Grid>
                        <Rectangle Fill="{DynamicResource BrHeroGlow}"/>
                        <Image Source="/Assets/logo.png" Width="190" Opacity="0.92"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-14,44,0"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="0"
                                                  Opacity="0.9" Color="#A855F7"/>
                            </Image.Effect>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Margin="26,24,0,0" VerticalAlignment="Top">
                    <TextBlock x:Name="GreetingText" Style="{StaticResource H1}" Text="Bem-vindo"/>
                    <TextBlock Text="O teu centro de instalação e ferramentas FiveM."
                               Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- cartões sobrepostos ao banner -->
                <UniformGrid Columns="2" VerticalAlignment="Bottom" Margin="14,0,14,14" Height="88">
                    <Border Background="#B3100E22" BorderBrush="#4DA855F7" BorderThickness="1"
                            CornerRadius="14" Padding="16,12" Margin="0,0,10,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Estado da comunidade" Style="{StaticResource Muted}" FontSize="11.5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource BrSuccess}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="CommunityText" Style="{StaticResource H2}" Text="Online"/>
                                </StackPanel>
                                <TextBlock Text="Todos os sistemas operacionais" Style="{StaticResource Muted}"
                                           FontSize="10.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="46" Height="46" CornerRadius="23" Background="#33A855F7"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Width="22" Height="22" Stretch="Uniform"
                                      Data="{DynamicResource IcoUsers}"
                                      Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="#B3100E22" BorderBrush="#4DA855F7" BorderThickness="1"
                            CornerRadius="14" Padding="16,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Apps instaladas" Style="{StaticResource Muted}" FontSize="11.5"/>
                                <TextBlock x:Name="InstalledText" Style="{StaticResource H2}" Text="—" Margin="0,5,0,0"/>
                                <TextBlock Text="Gestão de aplicações instalada" Style="{StaticResource Muted}"
                                           FontSize="10.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="46" Height="46" CornerRadius="23" Background="#33A855F7"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Width="20" Height="20" Stretch="Uniform"
                                      Data="{DynamicResource IcoGrid}"
                                      Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ===== Monitor de desempenho ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MONITOR DE DESEMPENHO" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="GpuNameText" Style="{StaticResource H2}" FontSize="19"
                               Margin="0,3,0,12" Text="—"/>

                    <UniformGrid Columns="4">
                        <!-- GPU -->
                        <Border Style="{StaticResource Tile}" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="GpuSparkHost" VerticalAlignment="Bottom" Height="34"
                                      Margin="-14,0,-14,-12" ClipToBounds="True">
                                    <Path x:Name="GpuSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrAccent}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Style="{StaticResource GaugeTrack}"/>
                                        <Path x:Name="GpuArc" Style="{StaticResource GaugeArc}"
                                              Stroke="{DynamicResource BrAccent}"/>
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="{DynamicResource IcoBolt}"
                                              Stroke="{DynamicResource BrAccent}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="USO GPU" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                        <TextBlock x:Name="GpuText" Style="{StaticResource H2}" FontSize="21"
                                                   Text="—" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RAM -->
                        <Border Style="{StaticResource Tile}" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="RamSparkHost" VerticalAlignment="Bottom" Height="34"
                                      Margin="-14,0,-14,-12" ClipToBounds="True">
                                    <Path x:Name="RamSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrInfo}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Style="{StaticResource GaugeTrack}"/>
                                        <Path x:Name="RamArc" Style="{StaticResource GaugeArc}"
                                              Stroke="{DynamicResource BrInfo}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="USO RAM" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                        <TextBlock x:Name="RamText" Style="{StaticResource H2}" FontSize="21"
                                                   Text="—" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="RamDetailText" Style="{StaticResource Muted}" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- CPU -->
                        <Border Style="{StaticResource Tile}" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="CpuSparkHost" VerticalAlignment="Bottom" Height="34"
                                      Margin="-14,0,-14,-12" ClipToBounds="True">
                                    <Path x:Name="CpuSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrSuccess}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Style="{StaticResource GaugeTrack}"/>
                                        <Path x:Name="CpuArc" Style="{StaticResource GaugeArc}"
                                              Stroke="{DynamicResource BrSuccess}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="USO CPU" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                        <TextBlock x:Name="CpuText" Style="{StaticResource H2}" FontSize="21"
                                                   Text="—" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Disco -->
                        <Border Style="{StaticResource Tile}" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="DiskSparkHost" VerticalAlignment="Bottom" Height="34"
                                      Margin="-14,0,-14,-12" ClipToBounds="True">
                                    <Path x:Name="DiskSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrWarn}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Style="{StaticResource GaugeTrack}"/>
                                        <Path x:Name="DiskArc" Style="{StaticResource GaugeArc}"
                                              Stroke="{DynamicResource BrWarn}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DISCO" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                        <TextBlock x:Name="DiskText" Style="{StaticResource H2}" FontSize="21"
                                                   Text="—" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="DiskDetailText" Style="{StaticResource Muted}" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Temperaturas (sparkline larga) -->
                    <UniformGrid x:Name="TempGrid" Columns="2" Margin="0,10,0,0">
                        <Border x:Name="CpuTempTile" Style="{StaticResource Tile}" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#26A855F7"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Width="15" Height="15" Stretch="Uniform"
                                          Data="{DynamicResource IcoThermo}"
                                          Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TEMP CPU" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                    <TextBlock x:Name="CpuTempText" Style="{StaticResource H2}" FontSize="21"
                                               Text="—" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Grid x:Name="CpuTempSparkHost" Grid.Column="2" Margin="14,4,-14,-4" ClipToBounds="True">
                                    <Path x:Name="CpuTempSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrAccent}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Tile}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#26A855F7"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Width="15" Height="15" Stretch="Uniform"
                                          Data="{DynamicResource IcoThermo}"
                                          Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TEMP GPU" Style="{StaticResource SectionLabel}" FontSize="10"/>
                                    <TextBlock x:Name="GpuTempText" Style="{StaticResource H2}" FontSize="21"
                                               Text="—" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Grid x:Name="GpuTempSparkHost" Grid.Column="2" Margin="14,4,-14,-4" ClipToBounds="True">
                                    <Path x:Name="GpuTempSpark" Style="{StaticResource Spark}"
                                          Stroke="{DynamicResource BrAccent}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="TempAdminHint" Margin="0,8,0,0" Visibility="Collapsed"
                               Cursor="Hand" MouseLeftButtonUp="TempAdmin_Click"
                               FontSize="11" Foreground="{DynamicResource BrAccent}"
                               Text="🛡 Temperatura do CPU indisponível — clica para reiniciar em modo administrador e ativar a leitura completa."
                               TextWrapping="Wrap"/>

                    <!-- rodapé: CPU últimos 60s -->
                    <Grid Margin="0,12,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Atualizado há 60 segundos" Style="{StaticResource Muted}"
                                   FontSize="10.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="10.5"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrSuccess}"
                                     Margin="8,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="agora" Style="{StaticResource Muted}" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Grid x:Name="ChartHost" Width="86" Height="26" ClipToBounds="True">
                                <Path x:Name="ChartFill">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#55A855F7" Offset="0"/>
                                            <GradientStop Color="#00A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path x:Name="ChartStroke" Stroke="{DynamicResource BrAccent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Ping + Sistema ===== -->
            <Grid Margin="0,0,0,16" Height="140">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Data="{DynamicResource IcoGlobe}"
                                  Stroke="{DynamicResource BrMuted}" StrokeThickness="1.4"
                                  Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PING DE REDE" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- anel + estado lado a lado: o cartão é largo e baixo,
                             empilhá-los fazia o badge sobrepor o anel -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="84" Height="84">
                                <Ellipse Stroke="{DynamicResource BrBorder}" StrokeThickness="3"/>
                                <Path x:Name="PingArc" Stroke="{DynamicResource BrAccent}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PingText" Text="—" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource BrText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ms" Style="{StaticResource Muted}" FontSize="10.5"
                                               HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="PingBadge" Background="#1A34D399" CornerRadius="8"
                                    Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PingLabel" Text="—" FontSize="10.5"
                                           Foreground="{DynamicResource BrSuccess}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <!-- arte: logótipo Windows em bloom azul, do lado direito -->
                        <Path Data="{DynamicResource IcoWindows}" Stretch="Uniform"
                              Fill="{DynamicResource BrWindows}" Width="230" Height="230"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,-40,0" Opacity="0.9">
                            <Path.Effect>
                                <BlurEffect Radius="6"/>
                            </Path.Effect>
                        </Path>
                        <Border Background="#B314122B"/>

                        <StackPanel Margin="16,14,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      Data="{DynamicResource IcoWindows}"
                                      Fill="{DynamicResource BrMuted}" Margin="0,0,7,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="SISTEMA" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="OsText" Style="{StaticResource H2}" FontSize="20"
                                       Text="—" Margin="0,6,0,8"/>
                            <TextBlock Text="Sistema operativo" Style="{StaticResource Muted}" FontSize="11"/>
                            <TextBlock x:Name="OsDetailText" Style="{StaticResource Body}" FontSize="12"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Tempo ligado" Style="{StaticResource Muted}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="UptimeText" Style="{StaticResource Body}" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#33A855F7" CornerRadius="7" Padding="8,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
                            <TextBlock x:Name="ArchText" Text="64-bit" FontSize="10"
                                       Foreground="{DynamicResource BrAccent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Ações rápidas ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AÇÕES RÁPIDAS" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Columns="4" Margin="0,10,0,0">
                        <Button Style="{StaticResource QuickAction}" Margin="0,0,10,0"
                                Tag="{DynamicResource IcoBolt}" Click="QuickOptimize_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Otimizar Sistema" Style="{StaticResource Body}"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Melhorar desempenho" Style="{StaticResource Muted}" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickAction}" Margin="0,0,10,0"
                                Tag="{DynamicResource IcoBroom}" Click="QuickClean_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Limpeza Rápida" Style="{StaticResource Body}"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Remover ficheiros inúteis" Style="{StaticResource Muted}" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickAction}"
                                Tag="{DynamicResource IcoGame}" Click="QuickFiveM_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Instalar FiveM" Style="{StaticResource Body}"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Instalação rápida" Style="{StaticResource Muted}" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ===== Definições ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DEFINIÇÕES" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="#26A855F7" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Path Width="17" Height="17" Stretch="Uniform"
                                      Data="{DynamicResource IcoBolt}"
                                      Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Iniciar com o Windows" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Abre em segundo plano (bandeja) quando o PC liga."
                                           Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupCheck" Grid.Column="2" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="Startup_Toggled" Unchecked="Startup_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Notícias ===== -->
            <TextBlock Text="Notícias e atualizações" Style="{StaticResource H2}" Margin="0,4,0,10"/>
            <ItemsControl x:Name="NewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Body}"
                                           Margin="0,6,0,0" Foreground="{DynamicResource BrMuted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
