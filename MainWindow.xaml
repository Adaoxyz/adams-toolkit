<Window x:Class="AdamsToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AdamsToolkit.Views"
        Title="Adams Toolkit" Height="760" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource BrBg}"
        WindowStyle="None" ResizeMode="CanResize">
    <!-- janela OPACA (sem AllowsTransparency): ver WindowChromeHelper — a "layered" copiava a
         janela inteira para a CPU a cada frame das bolinhas/transições. Redimensionar pelo
         WindowChrome, cantos redondos pelo DWM (Win11). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource BrBg}"
            BorderBrush="{DynamicResource BrHeroBorder}" BorderThickness="1" ClipToBounds="True"
            TextOptions.TextFormattingMode="Display">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- brilho roxo discreto no canto (estilo do fundo do NX, na nossa cor) -->
            <Ellipse Grid.RowSpan="2" Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-380,-360,0,0" IsHitTestVisible="False" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33A66BFF" Offset="0"/>
                        <GradientStop Color="#00A66BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- bolinhas a deslizar por trás de tudo (login incluído) -->
            <v:ParticleField Grid.RowSpan="2" Count="42"/>

            <!-- ===== Barra de título ===== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource BrLogoBg}">
                        <Image Source="{DynamicResource ImgLogo}" Width="32" Height="32" Margin="-4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="ADAMS" FontSize="12.5" FontFamily="{StaticResource FontDisplay}" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrAccent}"/>
                    <TextBlock Text="·" Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource BrMuted}"/>
                    <TextBlock x:Name="PageCrumb" Text="Início" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrMuted}"/>
                    <Border x:Name="UpdateBanner" Background="{DynamicResource BrCard}" CornerRadius="7"
                            Padding="10,3" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateText" FontSize="11" Foreground="{DynamicResource BrAccent}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- registos e idioma/animação vivem nas Definições (pedido do dono) -->
                    <Button Content="—" Click="Minimize_Click" Style="{StaticResource ChromeButton}"/>
                    <Button x:Name="MaximizeBtn" Content="🗖" ToolTip="Ecrã inteiro"
                            Click="Maximize_Click" Style="{StaticResource ChromeButton}"/>
                    <Button Content="✕" Click="Close_Click" Style="{StaticResource ChromeButton}"/>
                </StackPanel>
            </Grid>

            <!-- ===== Corpo ===== -->
            <Grid Grid.Row="1" x:Name="MainArea" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Barra lateral estreita -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- utilizador + versão em baixo -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,12">
                            <Grid Width="34" Height="34" ToolTip="{Binding Text, ElementName=UserNameText}">
                                <Ellipse Stroke="{DynamicResource BrAccent}" StrokeThickness="1.5"/>
                                <Ellipse Width="27" Height="27">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrSuccess}" HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom" Stroke="{DynamicResource BrBg}" StrokeThickness="1.5"/>
                            </Grid>
                            <TextBlock x:Name="UserNameText" Text="—" FontSize="9.5" Margin="6,5,6,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="VersionText" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource BrMuted}"/>
                        </StackPanel>

                        <!-- 5 entradas; o resto são separadores dentro de cada página -->
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource RailButton}" Tag="{StaticResource IcoHome}"
                                         Content="Início" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAjustes" Style="{StaticResource RailButton}" Tag="{StaticResource IcoBolt}"
                                         Content="Otimizar" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavFiveM" Style="{StaticResource RailButton}" Tag="{StaticResource IcoGame}"
                                         Content="Jogo" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavInstall" Style="{StaticResource RailButton}" Tag="{StaticResource IcoGrid}"
                                         Content="Ferramentas" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavEditor" Style="{StaticResource RailButton}" Tag="{StaticResource IcoScissors}"
                                         Content="Clips" Checked="Nav_Checked" ToolTip="Editor de Clips — abre numa janela à parte"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource RailButton}" Tag="{StaticResource IcoGear}"
                                         Content="Definições" Checked="Nav_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Conteúdo -->
                <ContentControl Grid.Column="1" x:Name="ContentHost" Margin="30,14,30,18"/>

                <!-- Transição entre páginas: nome + subtítulo ao centro, some sozinho -->
                <Grid Grid.Column="1" x:Name="TransLayer" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                    <!-- véu na cor de fundo do tema ATUAL (era sempre o escuro = mancha preta no claro) -->
                    <Border Background="{DynamicResource BrBg}" Opacity="0.55"/>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock x:Name="TransTitle" FontSize="26" FontFamily="{StaticResource FontDisplay}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource BrText}"/>
                        <TextBlock x:Name="TransSub" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{DynamicResource BrMuted}"/>
                    </StackPanel>
                </Grid>

                <!-- Avisos rápidos (canto inferior direito) -->
                <StackPanel Grid.Column="1" x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,22,18" IsHitTestVisible="False"/>
            </Grid>

            <!-- ===== Ecrã de login (gate) ===== -->
            <ContentControl Grid.Row="1" x:Name="LoginHost"/>
        </Grid>
    </Border>
</Window>
