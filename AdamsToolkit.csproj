<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Adams Toolkit</AssemblyName>
    <RootNamespace>AdamsToolkit</RootNamespace>
    <!-- UMA fonte de verdade. O FileVersion ficou esquecido em 1.32.1.0 enquanto o
         Version ia em 2.0.3: o auto-update via a versão certa mas as Propriedades do
         ficheiro no Windows diziam outra, o que só confundia o suporte e a reputação
         junto do Defender. Sem FileVersion, o SDK deriva-o daqui. -->
    <Version>3.0.0</Version>
    <Company>ATL PVP</Company>
    <Product>Adams Toolkit</Product>
    <Authors>ATL PVP</Authors>
    <Description>Adams Toolkit — Gaming Setup Manager para jogadores FiveM do servidor ATL PVP. Instala launchers e utilitários a partir das fontes oficiais.</Description>
    <Copyright>© 2026 ATL PVP. Todos os direitos reservados.</Copyright>
    <AssemblyTitle>Adams Toolkit</AssemblyTitle>
    <NeutralLanguage>pt-PT</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Regra da pena: app de secretária, não servidor.
         GC de estação de trabalho e SEM background GC = menos uma thread sempre
         viva e menos RAM retida em idle; TieredPGO deixa o JIT afinar o que é
         mesmo usado. Nada disto muda comportamento, só o peso. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/logo.png" />
    <Resource Include="Assets/logo-a.png" />
    <Resource Include="Assets/app.ico" />
    <Resource Include="Lang/*.json" />
  </ItemGroup>

  <!-- bootstrap/ é um projeto SEPARADO (AdamsToolkitSetup); não o compilar aqui -->
  <ItemGroup>
    <Compile Remove="bootstrap/**" />
    <Page Remove="bootstrap/**" />
    <Resource Remove="bootstrap/**" />
    <None Remove="bootstrap/**" />
  </ItemGroup>

  <!-- WinForms só p/ o NotifyIcon da bandeja; tira os global usings que colidem com WPF -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
