<UserControl x:Class="AdamsToolkit.Views.OpenSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- linha "não faz X" com visto verde -->
        <Style x:Key="ClaimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Código Aberto" Style="{StaticResource H1}"/>
            <TextBlock Text="Todo o código desta aplicação é público. Qualquer pessoa pode ler o que ela faz — não é preciso acreditar em ninguém."
                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== Repositório ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoShield}" Fill="{DynamicResource BrAccent}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Ver o código" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="O programa que tens instalado é compilado a partir deste código, sem ofuscação nem compressão. Podes lê-lo, compilá-lo tu próprio e comparar."/>

                        <Border Background="{DynamicResource BrSurface}" CornerRadius="9" Padding="12,9" Margin="0,12,0,0">
                            <TextBlock x:Name="RepoUrlText" FontFamily="Consolas" FontSize="12.5"
                                       Foreground="{DynamicResource BrAccent}" TextWrapping="Wrap"/>
                        </Border>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="BtnRepo" Style="{StaticResource PrimaryButton}"
                                    Content="Abrir no GitHub" Click="BtnRepo_Click" Margin="0,0,8,8"/>
                            <Button x:Name="BtnTransparency" Style="{StaticResource GhostButton}"
                                    Content="Guia para staff" Click="BtnTransparency_Click" Margin="0,0,8,8"
                                    ToolTip="TRANSPARENCIA.md — o que a app faz e não faz, com a linha de código de cada operação"/>
                            <Button x:Name="BtnCopy" Style="{StaticResource GhostButton}"
                                    Content="Copiar link" Click="BtnCopy_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== O que não faz ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="O que esta aplicação não faz" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Cada ponto é verificável no código — o guia para staff indica o ficheiro e a linha."/>
                        <ItemsControl x:Name="ClaimList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                                Background="#1A34D399" VerticalAlignment="Top" Margin="0,1,10,0">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrSuccess}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource ClaimText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Estado das funcionalidades de input ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Verificação de PC — funcionalidades de teclado" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="O Snap Tap e a repetição de teclado alteram o input do jogo. Vêm desligados e só funcionam se o jogador os ligar à mão. Muitos servidores proíbem-nos — este é o estado neste PC, agora:"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrSurface}" CornerRadius="9" Padding="14,11">
                                <StackPanel>
                                    <TextBlock Text="Snap Tap" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource BrText}"/>
                                    <TextBlock x:Name="SnapTapState" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BrSurface}" CornerRadius="9" Padding="14,11">
                                <StackPanel>
                                    <TextBlock Text="Repetição de teclado" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource BrText}"/>
                                    <TextBlock x:Name="KeyRepeatState" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Estes estados estão guardados em ficheiros de texto simples (snaptap.json e keyrepeat.json), que qualquer staff pode abrir num screenshare sem confiar no que a app diz."/>

                        <Button x:Name="BtnOpenData" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Content="Abrir a pasta destes ficheiros"
                                Click="BtnOpenData_Click"/>
                    </StackPanel>
                </Border>

                <!-- ===== Licença ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Licença" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="GPL-3.0: qualquer pessoa pode estudar, alterar e distribuir o código, desde que o resultado continue aberto. O nome e o logótipo do Adams Toolkit não fazem parte da licença — um fork tem de usar nome próprio."/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
